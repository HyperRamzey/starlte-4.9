	bool "Display sub-system event logger (DECON/DSIM/DPP)"
        depends on DEBUG_INFO && EXYNOS_DECON_7885
        default y

config DECON_HIBER
	bool "DECON hiber mode"
        depends on EXYNOS_DECON_7885
        default n

config EXYNOS_DOZE
	bool "Suppot Doze mode to aod service"
	depends on EXYNOS_DECON_7885
	default n

config EXYNOS_SUPPORT_DOZE
	bool "Suppot backword compatibility for EXYNOS_DOZE"
	depends on EXYNOS_DOZE
	default y

config EXYNOS_SUPPORT_FB_HANDOVER
	bool "Suppot bootloader framebuffer handover"
	depends on EXYNOS_DECON_7885
	default y

# PORT-NOTE(dpu_7885): the 4.4 gate was
#     depends on EXYNOS_DECON_7885 && (ANDROID_VERSION >= 90000)
#     default y if (ANDROID_VERSION >= 90000)
# That does NOT survive into 4.9. In the 4.9 tree ANDROID_VERSION is a *string*
# fed from the build environment (Kconfig:11-13, "option env=\"ANDROID_VERSION\""),
# and the a30s defconfig does not set it. Kconfig evaluates the empty string as
# 0, so `>= 90000` is false and DPU_20 would be silently forced OFF - but the
# live running.config has CONFIG_DPU_20=y (running.config:2890) and
# dpu_7885/decon.h gates 7 struct/layout blocks on it. The compiling 9810
# sibling dropped the Android-version gate entirely; do the same here.
config DPU_20
	bool "New fence operation and New header sync with HWC2.0"
	depends on EXYNOS_DECON_7885
	default y

config LCD_HMT
	bool "Suppot video emul & aid reverse to VR"
	depends on EXYNOS_DECON_7885
	default n

config SUPPORT_MASK_LAYER
	bool "Support mask layer"
	depends on EXYNOS_DECON_LCD
	default y

config LOGGING_BIGDATA_BUG
	bool "Logging extra information when decon bug"
	depends on SEC_DEBUG
	default n

endif

