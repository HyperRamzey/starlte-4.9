menu "ARM GPU Configuration"
if (SOC_EXYNOS8895)
source "drivers/gpu/arm/tMIx/Kconfig"
endif
if (SOC_EXYNOS9810)
source "drivers/gpu/arm/tHEx/Kconfig"
endif
if (SOC_EXYNOS7885)

config MALI_TMIX
	bool "Mali TMIX (mimir) support"
	default n
	help
	  Enable this option to build support for the ARM Mali GPU found on
	  Exynos 7885 / Exynos 7904 (Galaxy A30s), which is the r26p0 drop.

choice
	prompt "Version Configuration"
	depends on MALI_TMIX
	default MALI_TMIX_R26P0

config MALI_TMIX_R26P0
	bool "mimir r26p0 driver"

endchoice

source "drivers/gpu/arm/b_r26p0/Kconfig"
endif
endmenu
