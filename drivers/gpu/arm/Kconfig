menu "ARM GPU Configuration"
if (SOC_EXYNOS8895)
source "drivers/gpu/arm/tMIx/Kconfig"
endif
if (SOC_EXYNOS9810)
source "drivers/gpu/arm/tHEx/Kconfig"
endif
if (SOC_EXYNOS7885)

# The A30s (Exynos 7885 / 7904) carries a Midgard r26p0.  b_r26p0/Kconfig
# already declares the real driver menu as MALI_MIDGARD, which is the name the
# stock 4.4.177 exynos7885 config uses.  Do NOT introduce a second MALI_TMIX
# here: tMIx/Kconfig defines MALI_TMIX as a tristate for the Exynos8895 mimir
# r5p0, and kconfig parses every stanza regardless of the surrounding "if", so
# a duplicate would silently pick a type and warn
# "ignoring type redefinition of 'MALI_TMIX'".
config MALI_TMIX_R26P0
	bool "Mali Midgard r26p0 driver (Exynos7885 / A30s)"

source "drivers/gpu/arm/b_r26p0/Kconfig"
endif
endmenu
